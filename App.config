<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <!-- Câu 7 & Câu 8: Cấu hình chuỗi kết nối trong App.config đọc qua ConfigurationManager -->
  <connectionStrings>
    <add name="QLSinhVien"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=QLSinhVien;Integrated Security=True;Connect Timeout=5"
         providerName="System.Data.SqlClient" />
    <add name="QLSinhVien_LocalDB"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=QLSinhVien;Integrated Security=True;Connect Timeout=5"
         providerName="System.Data.SqlClient" />
    <add name="QLSinhVien_DefaultServer"
         connectionString="Data Source=.;Initial Catalog=QLSinhVien;Integrated Security=True;Connect Timeout=5"
         providerName="System.Data.SqlClient" />
    <add name="QLSinhVien_SqlExpress"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=QLSinhVien;Integrated Security=True;Connect Timeout=5"
         providerName="System.Data.SqlClient" />
    <add name="QLSinhVien_SqlAuth"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=QLSinhVien;User ID=app_qlsinhvien;Password=Eaut@2026!;Connect Timeout=5"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
